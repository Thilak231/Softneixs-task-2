# --- 2. Import packages ---
import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt
from scipy import stats
import tabula
import os

# --- 3. Convert PDF to CSV (if PDF exists) ---
pdf_path = "titanic.pdf"
csv_path = "titanic.csv"

if os.path.exists(pdf_path):
    print("Converting PDF to CSV... Please wait.")
    tables = tabula.read_pdf(pdf_path, pages='all', multiple_tables=False)
    df = tables[0]
    df.to_csv(csv_path, index=False)
    print("✅ Converted and saved as titanic.csv")
else:
    print("⚠️ titanic.pdf not found. Please upload it before running this cell.")

# --- 4. Load data ---
df = pd.read_csv(csv_path)
print("\nShape of dataset:", df.shape)
display(df.head())

# --- 5. Basic info ---
print("\n-- Data Types --")
print(df.dtypes)
print("\n-- Missing Values --")
print(df.isnull().sum())

# --- 6. Rename columns (if PDF messed up names) ---
df.columns = [c.strip().replace(" ", "_") for c in df.columns]
print("\nCleaned column names:", df.columns.tolist())

# --- 7. Handle missing values ---
df_eda = df.copy()
if 'Age' in df_eda.columns:
    df_eda['Age'] = df_eda['Age'].fillna(df_eda['Age'].median())
if 'Embarked' in df_eda.columns:
    df_eda['Embarked'] = df_eda['Embarked'].fillna(df_eda['Embarked'].mode()[0])
if 'Fare' in df_eda.columns:
    df_eda['Fare'] = df_eda['Fare'].fillna(df_eda['Fare'].median())

print("\nAfter imputing missing values:")
print(df_eda.isnull().sum())

# --- 8. Numerical data distribution ---
num_cols = df_eda.select_dtypes(include=[np.number]).columns.tolist()
print("\nNumerical columns:", num_cols)

plt.figure(figsize=(12,5))
plt.subplot(1,2,1)
sns.histplot(df_eda['Age'], bins=30, kde=True).set_title('Age Distribution')
plt.subplot(1,2,2)
sns.boxplot(x=df_eda['Age']).set_title('Age Boxplot')
plt.tight_layout()
plt.show()

plt.figure(figsize=(12,5))
plt.subplot(1,2,1)
sns.histplot(df_eda['Fare'], bins=40, kde=True).set_title('Fare Distribution')
plt.subplot(1,2,2)
sns.boxplot(x=df_eda['Fare']).set_title('Fare Boxplot')
plt.tight_layout()
plt.show()

# --- 9. Categorical data counts ---
cat_cols = ['Sex', 'Pclass', 'Embarked', 'Survived']
for c in cat_cols:
    if c in df_eda.columns:
        plt.figure(figsize=(6,3))
        sns.countplot(x=c, data=df_eda).set_title(f'{c} Counts')
        plt.tight_layout()
        plt.show()

# --- 10. Survival Analysis ---
if set(['Sex','Survived']).issubset(df_eda.columns):
    plt.figure(figsize=(6,4))
    sns.countplot(x='Sex', hue='Survived', data=df_eda)
    plt.title('Survival by Sex')
    plt.show()

if set(['Pclass','Survived']).issubset(df_eda.columns):
    plt.figure(figsize=(6,4))
    sns.countplot(x='Pclass', hue='Survived', data=df_eda)
    plt.title('Survival by Passenger Class')
    plt.show()

# --- 11. Correlation Heatmap ---
plt.figure(figsize=(10,6))
sns.heatmap(df_eda.corr(numeric_only=True), annot=True, fmt=".2f", cmap='coolwarm')
plt.title('Correlation Matrix (Numeric Columns)')
plt.show()

# --- 12. Survival percentage by class ---
if 'Pclass' in df_eda.columns and 'Survived' in df_eda.columns:
    ctab = pd.crosstab(df_eda['Pclass'], df_eda['Survived'], normalize='index') * 100
    print("\nSurvival % by Passenger Class:")
    display(ctab.round(2))

# --- 13. Outlier detection (Fare) ---
if 'Fare' in df_eda.columns:
    Q1 = df_eda['Fare'].quantile(0.25)
    Q3 = df_eda['Fare'].quantile(0.75)
    IQR = Q3 - Q1
    lower = Q1 - 1.5 * IQR
    upper = Q3 + 1.5 * IQR
    outliers_iqr = df_eda[(df_eda['Fare'] < lower) | (df_eda['Fare'] > upper)]
    print(f"\nOutliers in Fare (IQR method): {len(outliers_iqr)}")
    display(outliers_iqr[['Fare','Pclass','Name']].head())

    z_scores = np.abs(stats.zscore(df_eda['Fare']))
    outliers_z = df_eda[z_scores > 3]
    print(f"Outliers in Fare (Z-score > 3): {len(outliers_z)}")

# --- 14. Pairplot for numeric columns ---
if set(['Age','Fare','Parch','SibSp','Survived']).issubset(df_eda.columns):
    sns.pairplot(df_eda[['Age','Fare','Parch','SibSp','Survived']], hue='Survived', diag_kind='hist')
    plt.suptitle('Pairplot (Selected Numeric Columns)', y=1.02)
    plt.show()

# --- 15. Feature Engineering Example ---
if set(['SibSp','Parch']).issubset(df_eda.columns):
    df_eda['FamilySize'] = df_eda['SibSp'] + df_eda['Parch'] + 1
    print("\nFamilySize Distribution:")
    display(df_eda['FamilySize'].value_counts().sort_index())

# --- 16. Save cleaned dataset ---
df_eda.to_csv("titanic_eda_cleaned.csv", index=False)
print("\n✅ Cleaned dataset saved as titanic_eda_cleaned.csv")
